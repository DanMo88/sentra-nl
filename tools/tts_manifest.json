{
"audio/s0001.mp3": "f|Hallo, goedemorgen!",
"audio/s0002.mp3": "m|Hoe gaat het met je?",
"audio/s0003.mp3": "f|Goed, dank je. En met jou?",
"audio/s0004.mp3": "m|Ook goed, dank je wel.",
"audio/s0005.mp3": "f|Hoe heet je?",
"audio/s0006.mp3": "m|Ik heet Sara.",
"audio/s0007.mp3": "f|Leuk je te ontmoeten.",
"audio/s0008.mp3": "m|Insgelijks!",
"audio/s0009.mp3": "f|Waar kom je vandaan?",
"audio/s0010.mp3": "m|Ik kom uit Iran.",
"audio/s0011.mp3": "f|Waar woon je?",
"audio/s0012.mp3": "m|Ik woon nu in Utrecht.",
"audio/s0013.mp3": "f|Spreek je Nederlands?",
"audio/s0014.mp3": "m|Ja, een beetje.",
"audio/s0015.mp3": "f|Ik leer elke dag Nederlands.",
"audio/s0016.mp3": "m|Wat doe je voor werk?",
"audio/s0017.mp3": "f|Ik ben verpleegkundige.",
"audio/s0018.mp3": "m|Dit is mijn man, Ali.",
"audio/s0019.mp3": "f|En dit is onze dochter.",
"audio/s0020.mp3": "m|Hoe oud ben je?",
"audio/s0021.mp3": "f|Ik ben dertig jaar.",
"audio/s0022.mp3": "m|Goedemiddag, hoe gaat het met u?",
"audio/s0023.mp3": "f|Fijne dag nog!",
"audio/s0024.mp3": "m|Dank je, jij ook!",
"audio/s0025.mp3": "f|Tot ziens!",
